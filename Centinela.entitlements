<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Caja de arena activada, con exactamente dos permisos: salir a la red (Sentry) y
	     leer del llavero. No hay acceso a archivos, ni a la cámara, ni a contactos, ni
	     servidor de red entrante. Si algún día hace falta uno más, que se note en el diff.

	     No se declara `keychain-access-groups`: `$(AppIdentifierPrefix)` sólo se expande con
	     un perfil de aprovisionamiento y acá se firma ad-hoc. Sin la clave, el grupo por
	     omisión es el identificador de la propia aplicación, que es lo que se quiere. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
