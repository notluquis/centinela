<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox on, with exactly two permissions: reach the network, and read the Keychain.
	     No file access, no camera, no contacts, no inbound network server. If one more is ever
	     needed, it shows up in the diff.

	     `keychain-access-groups` is deliberately not declared: `$(AppIdentifierPrefix)` only
	     expands with a provisioning profile and these builds are signed ad-hoc. Without the key
	     the default group is the app's own identifier, which is what is wanted. Verified by
	     running a sandboxed ad-hoc bundle: SecItemAdd returns 0 and the value reads back. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The only two lines here that are not "reach the network", and they exist for exactly
	     one reason: a sandboxed app cannot replace itself, so Sparkle installs the update from
	     `Installer.xpc` and needs to be able to look those services up by name. The suffixes
	     are Sparkle's own convention (`-spks` for the status service, `-spki` for the
	     installer). No team identifier is involved, which is why this works with an ad-hoc
	     signature. -->
	<!-- PRUEBA: sin esto dyld rechaza cargar Sparkle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>cl.bioalergia.centinela-spks</string>
		<string>cl.bioalergia.centinela-spki</string>
	</array>
</dict>
</plist>
