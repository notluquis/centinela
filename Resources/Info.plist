<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Centinela</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Centinela</string>
	<key>CFBundleExecutable</key>
	<string>Centinela</string>
	<key>CFBundleIconFile</key>
	<string>Centinela</string>
	<key>CFBundleIdentifier</key>
	<string>cl.bioalergia.centinela</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon and no entry in the app switcher: this lives up in the menu bar and
	     nowhere else. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Sparkle. The public half of the EdDSA key pair; the private half never leaves the
	     release runner. This is what an update is verified against, and it does not involve
	     Apple, which is why a signature Apple did not issue is enough. -->
	<key>SUPublicEDKey</key>
	<string>FaHOx61prb3WXdRUcCf/RTE6jX7jxYyCmmlli7BO998=</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/notluquis/centinela/main/appcast.xml</string>
	<!-- The app is sandboxed, so installing an update means writing outside the container.
	     Sparkle does that from `Installer.xpc`, which this key turns on. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Finder's Get Info and the standard About panel show this verbatim. It said "MIT",
	     which names a licence and not a copyright holder. -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Lucas Pulgar-Escobar. MIT licensed.</string>
	<!-- Absent until now, which leaves the app uncategorised in Finder and Launchpad. It reads
	     Sentry and nothing else, so developer tools is what it is. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
</dict>
</plist>
